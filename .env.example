# Copy to backend/.env (or export in shell). Never commit a real key.
# Active provider: meta | commandcode | kilo | google (or switch live in the Settings UI)
AI_PROVIDER=meta
MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
COMMANDCODE_API_KEY=
COMMANDCODE_MODEL=
KILO_API_KEY=
KILO_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# OFFLINE_MODE=true forces deterministic offline mode even if a key exists
DATABASE_URL=sqlite:///./cybergenesis.db
SIM_STEP_DELAY_MS=350
