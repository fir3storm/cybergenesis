# Copy to backend/.env (or export in shell). Never commit a real key.
# Active provider: meta | commandcode | kilo | google | baseten (or switch live in the Settings UI)
AI_PROVIDER=meta
# JSON list of frontend origins permitted to call the API. Add your hosted URL explicitly.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Set a private operator token for shared hosting; enter it in Settings, never VITE_*.
# ADMIN_TOKEN=replace-with-a-long-random-secret
MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
COMMANDCODE_API_KEY=
COMMANDCODE_MODEL=
KILO_API_KEY=
KILO_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Meta open-weight Muse Spark Open via Baseten (hackathon model id)
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# OFFLINE_MODE=true forces deterministic offline mode even if a key exists
# CERT_DEMO_KEY is REQUIRED (no default): HMAC key for signing/verifying proof
# certificates. Set any long random string; the backend refuses to start without it.
CERT_DEMO_KEY=
# Ed25519 key that signs run certificates; generated here on first use (gitignored)
CERT_SIGNING_KEY_PATH=./cert_signing_key.pem
DATABASE_URL=sqlite:///./cybergenesis.db
SIM_STEP_DELAY_MS=350
